{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["REDIS_URL", "REDIS_TOKEN", "DATABASE_URL", "NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["REDIS_URL", "REDIS_TOKEN", "DATABASE_URL", "NODE_ENV"]
    },
    "db:migrate": {
      "outputs": []
    },
    "db:studio": {
      "outputs": []
    },
    "db:generate": {
      "outputs": []
    },
    "db:seed": {
      "outputs": []
    },
    "scrape": {
      "outputs": []
    }
  }
}
